+// Reglo REG-723: su iOS recente `showsPointsOfInterest` (deprecato da iOS 13)
+// non nasconde più i luoghi e restano toccabili: si usa il filtro nuovo.
+- (void)setShowsPointsOfInterest:(BOOL)showsPointsOfInterest
+{
+    super.showsPointsOfInterest = showsPointsOfInterest;
+    if (@available(iOS 13.0, *)) {
+        self.pointOfInterestFilter = showsPointsOfInterest ? nil : [MKPointOfInterestFilter filterExcludingAllCategories];
+    }
+    if (@available(iOS 16.0, *)) {
+        if (!showsPointsOfInterest) {
+            self.selectableMapFeatures = 0;
+        }
+    }
+}
